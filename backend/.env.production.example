# Backend (runtime) — na VPS copie para backend/.env e preencha. NÃO versionar o .env real.
DB_USER=postgres
DB_HOST=db                 # nome do serviço Postgres no docker-compose (NÃO use localhost)
DB_DATABASE=audisped_db
DB_PASSWORD=TROQUE_POR_SENHA_FORTE   # MESMA senha do .env raiz (serviço db)
DB_PORT=5432
PORT=15435

JWT_SECRET=TROQUE_POR_SEGREDO_FORTE_ALEATORIO

# IMPORTANTE: reusar a MESMA chave do backend/.env local — os certificados digitais
# já estão cifrados no banco com ela; trocar a chave os torna indecifráveis.
CERT_ENCRYPTION_KEY=REUSAR_A_CHAVE_ATUAL

# Tokens de terceiros (copiar do backend/.env local)
INFOSIMPLES_TOKEN=
ESPIAONFE_CLOUD_TOKEN=
ESPIAONFE_USER_TOKEN=
