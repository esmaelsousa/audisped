# Caddyfile — borda do AudiSped
#
# app.audisped.com.br   -> sistema (frontend + /api -> backend). Canônico do app.
# www.audisped.com.br   -> landing institucional estática (/srv/landing).
# audisped.com.br (raiz)-> redireciona 301 para www (a landing pública).
# :80                   -> fallback do sistema por acesso direto via IP.
#
# HTTPS (Let's Encrypt) automático para os 3 nomes. Backups: /opt/audisped/Caddyfile.bak.*

{
	email esmaelsousa@gmail.com
}

# --- Sistema (app) ---
app.audisped.com.br {
	encode gzip zstd

	@api path /api/*
	handle @api {
		reverse_proxy audisped-backend:15435
	}

	handle {
		reverse_proxy audisped-frontend:80
	}
}

# --- Landing institucional (www) ---
www.audisped.com.br {
	encode gzip zstd
	root * /srv/landing
	file_server
}

# --- Raiz -> www (landing) ---
audisped.com.br {
	redir https://www.audisped.com.br{uri} permanent
}

# --- Fallback por IP (HTTP direto) -> sistema ---
:80 {
	encode gzip zstd

	@api path /api/*
	handle @api {
		reverse_proxy audisped-backend:15435
	}

	handle {
		reverse_proxy audisped-frontend:80
	}
}
