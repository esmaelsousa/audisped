# Caddyfile — borda do AudiSped
#
# ESTADO ATUAL (sem domínio ainda): serve por HTTP no IP da VPS para testes
# ponta-a-ponta. Quando o domínio estiver registrado e apontando para a VPS,
# TROQUE o bloco ":80" abaixo por:
#
#     audisped.SEU-DOMINIO.com.br {
#         encode gzip zstd
#         @api path /api/*
#         handle @api {
#             reverse_proxy audisped-backend:15435
#         }
#         handle {
#             reverse_proxy audisped-frontend:80
#         }
#     }
#
# ...e o Caddy provisiona/renova o certificado HTTPS (Let's Encrypt) sozinho.
# (e-mail para avisos do Let's Encrypt já configurado abaixo)

{
	email esmaelsousa@gmail.com
}

:80 {
	encode gzip zstd

	# /api/* -> backend Express (porta interna 15435)
	@api path /api/*
	handle @api {
		reverse_proxy audisped-backend:15435
	}

	# todo o resto -> frontend (nginx servindo o build Vue, com fallback SPA)
	handle {
		reverse_proxy audisped-frontend:80
	}
}
