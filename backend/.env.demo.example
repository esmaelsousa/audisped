# .env.demo — variáveis do backend DEMO. Copie para backend/.env.demo e preencha.
# NÃO reutilize os segredos de produção — gere novos (o ambiente demo é aberto).
#
# DB_* NÃO ficam aqui: são definidos no docker-compose.demo.yml (apontando para demo-db).
# DEMO_MODE também é setado no compose ("1").

# Segredos (gere valores NOVOS, distintos da produção):
JWT_SECRET=
CERT_ENCRYPTION_KEY=

# Usuário demo (login compartilhado) — usados pelo demo-reset.js ao (re)criar o usuário:
DEMO_USER_EMAIL=demo@audisped.com.br
DEMO_USER_NOME=Demonstração
DEMO_USER_PASSWORD=demo1234

# Tokens de integrações externas: deixe VAZIOS na demo (recursos que chamam serviços
# pagos/externos ficam inertes; a demo é sobre importar SPED e validar/corrigir).
INFOSIMPLES_TOKEN=
ESPIAONFE_CLOUD_TOKEN=
ESPIAONFE_USER_TOKEN=

# Porta interna do backend (mantém o default da imagem):
PORT=15435
